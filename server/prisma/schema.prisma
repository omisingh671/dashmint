datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

enum GlobalRole {
  SUPER_ADMIN
  ADMIN
}

model User {
  id           String               @id @default(uuid())
  email        String               @unique
  passwordHash String
  globalRole   GlobalRole           @default(ADMIN)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  assignments       DashboardAssignment[]
  auditLogs         AuditLog[]
  reportAssignments ReportAssignment[]

  @@map("users")
}

model Dashboard {
  id          String                @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  connection  DatabaseConnection?
  assignments DashboardAssignment[]
  models      SchemaModel[]
  relations   TableRelation[]
  reports     Report[]

  @@map("dashboards")
}

model DatabaseConnection {
  id          String    @id @default(uuid())
  dashboardId String    @unique
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  host        String
  port        Int       @default(3306)
  username    String
  password    String
  database    String
  sslEnabled  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("database_connections")
}

model DashboardAssignment {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dashboardId     String
  dashboard       Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  permissionsJson String    // JSON containing permissions (e.g. { "read": true, "export": true })
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, dashboardId])
  @@map("dashboard_assignments")
}

model SchemaModel {
  id          String        @id @default(uuid())
  dashboardId String
  dashboard   Dashboard     @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  name        String        // Actual database table name
  displayName String        // User friendly label (singularized/capitalized)
  isVisible   Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  fields      SchemaField[]

  @@unique([dashboardId, name])
  @@map("schema_models")
}

model SchemaField {
  id            String      @id @default(uuid())
  schemaModelId String
  schemaModel   SchemaModel @relation(fields: [schemaModelId], references: [id], onDelete: Cascade)
  name          String      // Actual database column name
  displayName   String      // User friendly label
  type          String      // data type e.g., varchar, int, datetime
  isPrimaryKey  Boolean     @default(false)
  isNullable    Boolean     @default(true)
  isUnique      Boolean     @default(false)
  isVisible     Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([schemaModelId, name])
  @@map("schema_fields")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // e.g., "USER_LOGIN", "CREATE_DASHBOARD", "EXPORT_CSV"
  details   String   @db.Text
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

model TableRelation {
  id          String    @id @default(uuid())
  dashboardId String
  dashboard   Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  fromTable   String    @db.VarChar(64) // e.g., "orders"
  fromColumn  String    @db.VarChar(64) // e.g., "user_id"
  toTable     String    @db.VarChar(64) // e.g., "users"
  toColumn    String    @db.VarChar(64) // e.g., "id"
  isManual    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([dashboardId, fromTable, fromColumn, toTable, toColumn])
  @@map("table_relations")
}

model Report {
  id                String             @id @default(uuid())
  dashboardId       String
  dashboard         Dashboard          @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  baseTable         String             // e.g., "orders"
  columnsJson       String             @db.Text // JSON: Array<{ table: string, field: string, alias: string }>
  joinsJson         String             @db.Text // JSON: Array<{ type: 'LEFT'|'INNER', relatedTable: string, fromColumn: string, toColumn: string }>
  filtersJson       String             @db.Text // JSON: Array<{ table: string, field: string, operator: 'equals'|'contains'|'greaterThan'|'lessThan', value: string }>
  defaultSortColumn String?
  defaultSortOrder  String?            @default("ASC")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  assignments       ReportAssignment[]

  @@map("reports")
}

model ReportAssignment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  canExport Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, reportId])
  @@map("report_assignments")
}
